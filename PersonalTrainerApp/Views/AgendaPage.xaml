<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PersonalTrainerApp.Views.AgendaPage"
    Title="Agenda"
    BackgroundColor="#111827">

    <Grid RowDefinitions="Auto,Auto,*" Padding="18" RowSpacing="14">

        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <VerticalStackLayout Spacing="2">
                <Label
                    Text="Agenda de horários"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Planilha semanal de horários. Arraste para o lado para ver todos os horários."
                    FontSize="13"
                    TextColor="#9CA3AF"/>
            </VerticalStackLayout>

            <Button
                Grid.Column="1"
                Text="Fechar"
                BackgroundColor="#1F2937"
                TextColor="White"
                Clicked="Fechar"
                HeightRequest="42"
                CornerRadius="21"/>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Button
                x:Name="LimparDestaqueButton"
                Grid.Column="0"
                Text="Limpar destaque"
                BackgroundColor="#374151"
                TextColor="White"
                Clicked="LimparDestaque"
                IsVisible="False"
                HeightRequest="42"
                CornerRadius="21"/>

            <Button
                Grid.Column="1"
                Text="Importar Excel"
                BackgroundColor="#1F2937"
                TextColor="White"
                Clicked="ImportarExcel"
                HeightRequest="42"
                CornerRadius="21"/>

            <Button
                Grid.Column="2"
                Text="Salvar"
                BackgroundColor="#4ADE80"
                TextColor="#0B0F19"
                Clicked="Salvar"
                HeightRequest="42"
                CornerRadius="21"/>
        </Grid>

        <ScrollView
            Grid.Row="2"
            Orientation="Both">
            <Grid
                x:Name="AgendaGrid"
                RowSpacing="6"
                ColumnSpacing="6"/>
        </ScrollView>
    </Grid>
</ContentPage>
