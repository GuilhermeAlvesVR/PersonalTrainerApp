<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PersonalTrainerApp.Views.FichaTreinoPage"
    Title="Ficha do aluno"
    BackgroundColor="#111827">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <Label
                    Text="Ficha do aluno"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"/>

                <Button
                    Grid.Column="1"
                    Text="Fechar"
                    BackgroundColor="#1F2937"
                    TextColor="White"
                    Clicked="Fechar"
                    HeightRequest="40"
                    CornerRadius="20"/>
            </Grid>

            <Frame
                x:Name="MensagemSucesso"
                IsVisible="False"
                BackgroundColor="#2E7D32"
                CornerRadius="8"
                Padding="8,4"
                HorizontalOptions="Start">

                <Label
                    Text="Treino salvo."
                    TextColor="White"
                    FontSize="12"/>
            </Frame>

            <Frame
                Padding="18"
                CornerRadius="18"
                BorderColor="#1F2937"
                BackgroundColor="#0B0F19"
                HasShadow="True">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="4">

                            <Label
                                Text="{Binding AlunoSelecionadoAtual.Nome}"
                                FontSize="26"
                                FontAttributes="Bold"
                                TextColor="White"
                                MaxLines="1"
                                LineBreakMode="TailTruncation"/>

                            <Label
                                Text="{Binding AlunoSelecionadoAtual.TreinoSelecionado.NomeTreino}"
                                FontSize="17"
                                TextColor="#9CA3AF"
                                MaxLines="1"
                                LineBreakMode="TailTruncation"/>

                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border
                                Grid.Column="0"
                                WidthRequest="80"
                                HeightRequest="45"
                                BackgroundColor="#111827"
                                Stroke="#1F2937"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                VerticalOptions="Center">

                                <Label
                                    Text="{Binding AlunoSelecionadoAtual.UltimoTreinoRealizado}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    HorizontalTextAlignment="Center"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="#4ADE80"/>

                            </Border>

                            <Button
                                Grid.Column="2"
                                Text="Editar"
                                BackgroundColor="#4ADE80"
                                TextColor="#0B0F19"
                                Clicked="EditarTreino"
                                WidthRequest="90"
                                HeightRequest="45"
                                CornerRadius="22"
                                VerticalOptions="Center"/>

                        </Grid>

                    <Grid
                        ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
                        ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Text="A"
                            WidthRequest="56"
                            HeightRequest="56"
                            MinimumWidthRequest="56"
                            MinimumHeightRequest="56"
                            CornerRadius="28"
                            FontSize="18"
                            Padding="0"
                            Clicked="SelecionarTreinoA"
                            IsVisible="{Binding AlunoSelecionadoAtual.TemTreinoA}"/>

                        <Button
                            Grid.Column="1"
                            Text="B"
                            WidthRequest="56"
                            HeightRequest="56"
                            MinimumWidthRequest="56"
                            MinimumHeightRequest="56"
                            CornerRadius="28"
                            FontSize="18"
                            Padding="0"
                            Clicked="SelecionarTreinoB"
                            IsVisible="{Binding AlunoSelecionadoAtual.TemTreinoB}"/>

                        <Button
                            Grid.Column="2"
                            Text="C"
                            WidthRequest="56"
                            HeightRequest="56"
                            MinimumWidthRequest="56"
                            MinimumHeightRequest="56"
                            CornerRadius="28"
                            FontSize="18"
                            Padding="0"
                            Clicked="SelecionarTreinoC"
                            IsVisible="{Binding AlunoSelecionadoAtual.TemTreinoC}"/>

                        <Button
                            Grid.Column="3"
                            Text="D"
                            WidthRequest="56"
                            HeightRequest="56"
                            MinimumWidthRequest="56"
                            MinimumHeightRequest="56"
                            CornerRadius="28"
                            FontSize="18"
                            Padding="0"
                            Clicked="SelecionarTreinoD"
                            IsVisible="{Binding AlunoSelecionadoAtual.TemTreinoD}"/>

                        <Button
                            Grid.Column="5"
                            Text="Salvar"
                            Clicked="SalvarTreinoFeito"
                            BackgroundColor="#166534"
                            TextColor="White"
                            WidthRequest="90"
                            HeightRequest="56"
                            CornerRadius="28"/>

                    </Grid>

                    

                    <VerticalStackLayout
                        IsVisible="{Binding AlunoSelecionadoAtual.TemTreino}"
                        Spacing="8">

                        <Grid ColumnDefinitions="2*,*,*,*" Padding="0,8,0,0">
                            <Label
                                Text="Exercício"
                                FontAttributes="Bold"
                                TextColor="#9CA3AF"/>

                            <Label
                                Grid.Column="1"
                                Text="Séries"
                                FontAttributes="Bold"
                                TextColor="#9CA3AF"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Grid.Column="2"
                                Text="Rep."
                                FontAttributes="Bold"
                                TextColor="#9CA3AF"
                                HorizontalTextAlignment="Center"/>

                            <Label
                                Grid.Column="3"
                                Text="Carga"
                                FontAttributes="Bold"
                                TextColor="#9CA3AF"
                                HorizontalTextAlignment="Center"/>
                        </Grid>

                        <CollectionView
                            ItemsSource="{Binding AlunoSelecionadoAtual.TreinoSelecionado.Exercicios}">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        BackgroundColor="#0F172A"
                                        Stroke="#172033"
                                        StrokeThickness="1"
                                        Padding="12"
                                        Margin="0,4"
                                        StrokeShape="RoundRectangle 12">

                                        <Grid ColumnDefinitions="2*,*,*,*">
                                            <Label
                                                Text="{Binding Nome}"
                                                TextColor="White"
                                                FontSize="15"/>

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Series}"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center"/>

                                            <Label
                                                Grid.Column="2"
                                                Text="{Binding Repeticoes}"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center"/>

                                            <Label
                                                Grid.Column="3"
                                                Text="{Binding Carga}"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        IsVisible="{Binding AlunoSelecionadoAtual.SemTreino}"
                        Spacing="15"
                        Padding="0,20">

                        <Label
                            Text="Nenhum treino cadastrado"
                            FontSize="18"
                            TextColor="#9CA3AF"/>

                        <Button
                            Text="Criar treino"
                            BackgroundColor="#4ADE80"
                            TextColor="#0B0F19"
                            HeightRequest="45"
                            CornerRadius="22"
                            Clicked="EditarTreino"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
