<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PersonalTrainerApp.Views.HistoricoAvaliacoesPage"
    Title="Histórico de Avaliações"
    BackgroundColor="#111827">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="22" MaximumWidthRequest="1000">

            <Label
                Text="Histórico de avaliações"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="White"/>

            <Button
                Text="Voltar"
                BackgroundColor="#1E293B"
                TextColor="White"
                WidthRequest="150"
                HeightRequest="44"
                CornerRadius="22"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                Clicked="Voltar"/>

            <CollectionView x:Name="AvaliacoesCollection">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            BackgroundColor="#0F172A"
                            Stroke="#1E293B"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 20"
                            Padding="18"
                            Margin="0,0,0,14">

                            <VerticalStackLayout Spacing="10">

                                <Label
                                    Text="{Binding Data, StringFormat='{0:dd/MM/yyyy}'}"
                                    FontSize="20"
                                    FontAttributes="Bold"
                                    TextColor="White"/>

                                <Grid
                                    ColumnDefinitions="*,*"
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnSpacing="14"
                                    RowSpacing="8">

                                    <Label
                                        Text="{Binding Peso, StringFormat='Peso: {0} kg'}"
                                        TextColor="#D1D5DB"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Cintura, StringFormat='Cintura: {0} cm'}"
                                        TextColor="#D1D5DB"/>

                                    <Label
                                        Grid.Row="1"
                                        Text="{Binding Abdomen, StringFormat='Abdômen: {0} cm'}"
                                        TextColor="#D1D5DB"/>

                                    <Label
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="{Binding Braco, StringFormat='Braço: {0} cm'}"
                                        TextColor="#D1D5DB"/>

                                    <Label
                                        Grid.Row="2"
                                        Text="{Binding Coxa, StringFormat='Coxa: {0} cm'}"
                                        TextColor="#D1D5DB"/>

                                </Grid>

                                <Label
                                    Text="{Binding Observacoes, StringFormat='Obs: {0}'}"
                                    TextColor="#9CA3AF"
                                    FontSize="14"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>