<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="PersonalTrainerApp.Views.AlunoCadastroPage"
    Title="Cadastrar Aluno"
    BackgroundColor="#111827">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="18">

            <Label
                Text="Cadastrar aluno"
                FontSize="34"
                FontAttributes="Bold"
                TextColor="White"/>

            <Button
    Text="← Voltar"
    BackgroundColor="#1E293B"
    TextColor="White"
    WidthRequest="150"
    HeightRequest="44"
    CornerRadius="22"
    FontAttributes="Bold"
    HorizontalOptions="Start"
    Clicked="Voltar"/>

            <Entry
                x:Name="NomeEntry"
                Placeholder="Nome do aluno"
                BackgroundColor="#0F172A"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                HeightRequest="52"/>

            <Entry
                x:Name="IdadeEntry"
                Placeholder="Idade"
                Keyboard="Numeric"
                BackgroundColor="#0F172A"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                HeightRequest="52"/>

            <Entry
                x:Name="PesoEntry"
                Placeholder="Peso"
                Keyboard="Numeric"
                BackgroundColor="#0F172A"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                HeightRequest="52"/>

            <Entry
                x:Name="AlturaEntry"
                Placeholder="Altura"
                Keyboard="Numeric"
                BackgroundColor="#0F172A"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                HeightRequest="52"/>

            <Entry
                x:Name="ObjetivoEntry"
                Placeholder="Objetivo"
                BackgroundColor="#0F172A"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                HeightRequest="52"/>

            <Editor
                x:Name="ObservacoesEditor"
                Placeholder="Observações"
                BackgroundColor="#0F172A"
                TextColor="White"
                PlaceholderColor="#9CA3AF"
                HeightRequest="120"
                AutoSize="TextChanges"/>

            <BoxView
                HeightRequest="1"
                BackgroundColor="#1E293B"/>

            <Label
                Text="Criar treino inicial?"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="White"/>

            <Switch
                x:Name="CriarTreinoSwitch"
                IsToggled="True"
                OnColor="#4ADE80"
                ThumbColor="White"
                Toggled="CriarTreinoSwitch_Toggled"/>

            <VerticalStackLayout
                x:Name="TreinoContainer"
                BackgroundColor="#111827"
                Padding="18"
                Spacing="16">

                <Picker
                    x:Name="LetraTreinoPicker"
                    Title="Treino"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    SelectedIndexChanged="LetraTreinoPicker_SelectedIndexChanged">

                    <Picker.Items>
                        <x:String>A</x:String>
                        <x:String>B</x:String>
                        <x:String>C</x:String>
                        <x:String>D</x:String>
                    </Picker.Items>

                </Picker>

                <Entry
                    x:Name="NomeTreinoEntry"
                    Placeholder="Nome do treino"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    PlaceholderColor="#9CA3AF"
                    HeightRequest="52"/>

                <Label
                    Text="Adicionar exercício"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Entry
                    x:Name="NomeExercicioEntry"
                    Placeholder="Nome do exercício"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    PlaceholderColor="#9CA3AF"
                    HeightRequest="52"/>

                <Entry
                    x:Name="SeriesEntry"
                    Placeholder="Séries"
                    Keyboard="Numeric"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    PlaceholderColor="#9CA3AF"
                    HeightRequest="52"/>

                <Entry
                    x:Name="RepeticoesEntry"
                    Placeholder="Repetições"
                    Keyboard="Numeric"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    PlaceholderColor="#9CA3AF"
                    HeightRequest="52"/>

                <Entry
                    x:Name="CargaEntry"
                    Placeholder="Carga. Ex: 40kg"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    PlaceholderColor="#9CA3AF"
                    HeightRequest="52"/>

                <Button
                    Text="Adicionar exercício"
                    BackgroundColor="#2563EB"
                    TextColor="White"
                    WidthRequest="220"
                    HeightRequest="46"
                    CornerRadius="22"
                    HorizontalOptions="Start"
                    Clicked="AdicionarExercicio"/>

                <CollectionView x:Name="ListaExercicios">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BackgroundColor="#0F172A"
                                Stroke="#1E293B"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="0,5"
                                StrokeShape="RoundRectangle 14">

                                <Grid ColumnDefinitions="2*,*,*,*,Auto">

                                    <Label
                                        Text="{Binding Nome}"
                                        TextColor="White"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Series}"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding Repeticoes}"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <Label
                                        Grid.Column="3"
                                        Text="{Binding Carga}"
                                        TextColor="White"
                                        HorizontalTextAlignment="Center"
                                        VerticalOptions="Center"/>

                                    <Button
                                        Grid.Column="4"
                                        Text="X"
                                        WidthRequest="36"
                                        HeightRequest="36"
                                        CornerRadius="18"
                                        BackgroundColor="#EF4444"
                                        TextColor="White"
                                        Clicked="RemoverExercicio"/>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

            <Button
                Text="Salvar aluno"
                BackgroundColor="#4ADE80"
                TextColor="#0B0F19"
                WidthRequest="220"
                HeightRequest="48"
                CornerRadius="22"
                FontAttributes="Bold"
                HorizontalOptions="Start"
                Clicked="SalvarAluno"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>